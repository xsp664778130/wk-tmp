#!/bin/bash

set -euo pipefail

readonly app_path="/Applications/SkillPort.app"
console_user="$(/usr/bin/stat -f '%Su' /dev/console)"

if [[ -z "${console_user}" || "${console_user}" == "root" || "${console_user}" == "loginwindow" ]]; then
  exit 0
fi

user_home="$(/usr/bin/dscl . -read "/Users/${console_user}" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
desktop_dir="${user_home}/Desktop"
shortcut_path="${desktop_dir}/SkillPort.app"

if [[ -d "${desktop_dir}" && ! -e "${shortcut_path}" && ! -L "${shortcut_path}" ]]; then
  /bin/ln -s "${app_path}" "${shortcut_path}"
  /usr/sbin/chown -h "${console_user}:staff" "${shortcut_path}" || true
fi

exit 0
